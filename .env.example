# Copiar a .env.local (app) y .env (worker y drizzle-kit).
# Ninguno de estos valores va al repositorio.

# --- Base de datos -------------------------------------------------
# Boton verde "Connect" del panel > Connection string > URI, reemplazando
# [YOUR-PASSWORD] por la contrasena de la base.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROYECTO.supabase.co:5432/postgres

# --- Supabase ------------------------------------------------------
# Boton "Connect" del panel, o Project Settings > Data API.
NEXT_PUBLIC_SUPABASE_URL=https://PROYECTO.supabase.co

# Project Settings > API Keys.
# Supabase renombro las claves: la "Publishable key" (sb_publishable_...) es la
# que antes se llamaba anon, y la "Secret key" (sb_secret_...) es la que antes
# se llamaba service_role. Los nombres de estas variables se mantienen para no
# tener que tocar el codigo; sirven las dos generaciones de claves.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor y worker. Bypassa RLS: nunca exponerla al navegador.
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_STORAGE_BUCKET=medios

# --- Cifrado de tokens ---------------------------------------------
# 32 bytes en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Worker --------------------------------------------------------
WORKER_ID=worker-local
WORKER_INTERVALO_MS=30000
# 1 en Fase 0: todos los adaptadores son el mock, no se llama a ninguna API real.
USE_MOCK_ADAPTERS=1
# Probabilidad de fallo simulado del mock, para probar reintentos (0 a 1).
MOCK_TASA_FALLO=0

# --- Notificaciones ------------------------------------------------
# Fase 0: consola. Cambiar a "resend" cuando el dominio este verificado.
NOTIFIER=console
RESEND_API_KEY=
RESEND_FROM="Witko Social <no-reply@ejemplo.com>"

# --- Meta (Fase 1) -------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=v21.0

# --- TikTok (Fase 2) -----------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
